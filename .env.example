# Copy to `.env` at the repository root. `.env` is gitignored and is the ONLY
# place local configuration lives — the backend, the worker and Docker Compose
# all read from it. Never commit it.

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Default setup is a NATIVE PostgreSQL 17 + pgvector install (README → Database).
# The role/database below are created by scripts/init-db.sql.
# These POSTGRES_* values are only read by docker-compose.yml, the optional
# containerised alternative; keep them in sync with DATABASE_URL.
POSTGRES_USER=secondbrain
POSTGRES_PASSWORD=secondbrain
POSTGRES_DB=secondbrain
POSTGRES_PORT=5432

# ── Backend (apps/api) ────────────────────────────────────────────────────
# SQLAlchemy URL — the only thing the application reads to find the database.
DATABASE_URL=postgresql+psycopg://secondbrain:secondbrain@127.0.0.1:5432/secondbrain
# Integration tests use a separate database; by default the name above with a
# `_test` suffix (created by scripts/init-db.sql). Override if yours differs.
# TEST_DATABASE_URL=postgresql+psycopg://secondbrain:secondbrain@127.0.0.1:5432/secondbrain_test
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# development | test | production
ENVIRONMENT=development

# Local-first: bind to loopback only. Change deliberately, not by default.
API_HOST=127.0.0.1
API_PORT=8000

# Origins allowed to call the API from a browser (the Next.js dev server).
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Managed storage for imported files. Relative paths resolve from the repo root.
DATA_DIR=data
MAX_UPLOAD_MB=200

# ── Ingestion ─────────────────────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=30
HTTP_USER_AGENT="SecondBrain/0.1 (+local-first personal knowledge tool)"
YOUTUBE_LANGUAGES=["en","en-US","en-GB"]
# Chunking (ARCHITECTURE.md §6). Starting points; tune against your own corpus.
CHUNK_TARGET_TOKENS=300
CHUNK_MAX_TOKENS=450
CHUNK_OVERLAP_RATIO=0.12
CHUNK_PARENT_MAX_TOKENS=2000

# ── Worker ────────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_STALE_JOB_SECONDS=900

# ── AI providers ──────────────────────────────────────────────────────────
# LLM (Phase 3): ollama = local runtime, nothing leaves this machine.
#   fake = deterministic stand-in for tests; none = answering disabled.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b-instruct
LLM_BASE_URL=http://127.0.0.1:11434
# num_ctx. Measured on an RTX 3050 (4 GB): at 4096 Ollama keeps ~67% of the layers
# on the GPU and generates ~26 tok/s; 8192 drops to ~58% and is slower.
LLM_CONTEXT_TOKENS=4096
LLM_MAX_OUTPUT_TOKENS=512
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120
# How long Ollama holds the model in VRAM between questions (it unloads after this).
LLM_KEEP_ALIVE=30m
# Qwen3 tags reason before answering unless told not to. Measured: 84s with an EMPTY
# answer (reasoning ate the token budget) versus 7.6s with it off. Leave false.
LLM_THINKING=false
# Store full prompts and responses in llm_calls. Off by default: the prompt contains
# your own source text, and the rows would duplicate the library.
LLM_LOG_PAYLOADS=false

# Embeddings (Phase 2): fastembed = local ONNX model on CPU, no API, no service.
#   fake = deterministic stand-in for tests / model-less development; none = disabled.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the chunk_embeddings column width (migration 0003). A model with a
# different width needs a new migration, not just a new value here.
EMBEDDING_DIMENSION=384
# Where the model is downloaded to on first use (~67 MB). Gitignored under data/.
EMBEDDING_CACHE_DIR=data/models
EMBEDDING_BATCH_SIZE=64

# ── Search ────────────────────────────────────────────────────────────────
SEARCH_CANDIDATES=50
SEARCH_RRF_K=60

# ── RAG / Ask (Phase 3) ───────────────────────────────────────────────────
RAG_MODE=hybrid
RAG_TOP_K=8
RAG_CONTEXT_TOKENS=3000
RAG_MAX_SOURCE_TOKENS=700
RAG_EXPAND_TO_PARENTS=true
# Cosine floor below which a semantic hit is not treated as evidence (a keyword hit
# always counts). Calibrated on the real corpus: answerable questions scored
# 0.651-0.860, questions the library genuinely cannot answer scored 0.440-0.527.
RAG_MIN_SIMILARITY=0.60
RAG_MIN_SOURCES=1

# ── Frontend (apps/web) ───────────────────────────────────────────────────
# Next.js only exposes variables prefixed NEXT_PUBLIC_ to the browser.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
